# Build stage
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
ARG VITE_MQTT_WS_URL=ws://broker.hivemq.com:8000/mqtt
ARG VITE_MQTT_TOPIC_TELEMETRIA=aula/grupoX/telemetria
ARG VITE_MQTT_TOPIC_ESTADO=aula/grupoX/estado
ARG VITE_MQTT_TOPIC_COMANDOS=aula/grupoX/comandos
ARG VITE_DEVICE_ID=ESP32-AULA-101
ARG VITE_USE_MOCK=false
ARG VITE_DATA_SOURCE=nodered-api
ARG VITE_API_BASE=/api
ARG VITE_POLL_INTERVAL_MS=5000
ENV VITE_MQTT_WS_URL=$VITE_MQTT_WS_URL
ENV VITE_MQTT_TOPIC_TELEMETRIA=$VITE_MQTT_TOPIC_TELEMETRIA
ENV VITE_MQTT_TOPIC_ESTADO=$VITE_MQTT_TOPIC_ESTADO
ENV VITE_MQTT_TOPIC_COMANDOS=$VITE_MQTT_TOPIC_COMANDOS
ENV VITE_DEVICE_ID=$VITE_DEVICE_ID
ENV VITE_USE_MOCK=$VITE_USE_MOCK
ENV VITE_DATA_SOURCE=$VITE_DATA_SOURCE
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_POLL_INTERVAL_MS=$VITE_POLL_INTERVAL_MS
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
