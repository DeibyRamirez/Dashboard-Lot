# Zona horaria del contenedor Node-RED
TZ=America/Bogota

# Dispositivo y tópicos MQTT (HiveMQ público)
DEVICE_ID=ESP32-AULA-101
MQTT_TOPIC_TELEMETRIA=aula/grupoX/telemetria
MQTT_TOPIC_ESTADO=aula/grupoX/estado
MQTT_TOPIC_COMANDOS=aula/grupoX/comandos

# Simulador de telemetría en Node-RED (true = publica cada 5s cuando el flujo está desplegado)
SEED_SIMULATOR=false

# --- Dashboard web (Vite) ---
# nodered-api = poll HTTP vía nginx → Node-RED (recomendado si WebSocket MQTT está bloqueado)
# mqtt = conexión directa WebSocket a HiveMQ desde el navegador
VITE_DATA_SOURCE=nodered-api
VITE_API_BASE=/api
VITE_MQTT_WS_URL=ws://broker.hivemq.com:8000/mqtt
VITE_MQTT_TOPIC_TELEMETRIA=aula/grupoX/telemetria
VITE_MQTT_TOPIC_ESTADO=aula/grupoX/estado
VITE_MQTT_TOPIC_COMANDOS=aula/grupoX/comandos
VITE_DEVICE_ID=ESP32-AULA-101
# Modo demo sin broker (solo frontend)
VITE_USE_MOCK=false
# Intervalo de poll HTTP (ms); alinear con PUBLISH_PERIOD_S del firmware (ej. 5000 o 2000)
VITE_POLL_INTERVAL_MS=5000
VITE_HISTORY_MAX_POINTS=60
